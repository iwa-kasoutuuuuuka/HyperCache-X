<Window x:Class="HCX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="HyperCache X v2.2.0 - 3-Tier Hybrid Storage &amp; RAMDisk Engine"
        Height="820"
        Width="1160"
        MinHeight="700"
        MinWidth="980"
        Background="#0A0A0C"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI Variable Display, Segoe UI">
  <Window.Resources>
    <ResourceDictionary>
      <Style x:Key="CardPanel" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#16161D" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderBrush" Value="#25252D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.3" ShadowDepth="2" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#2A2A35" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="0" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="#3A3A4D" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="0.35" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
      </Style>
      <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="#999" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabItem}">
              <Border x:Name="Bd" Background="#1D1D26" BorderBrush="#2A2A36" BorderThickness="1" CornerRadius="6" Margin="0,0,6,8" Padding="{TemplateBinding Padding}">
                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#243B55" />
                  <Setter TargetName="Bd" Property="BorderBrush" Value="#4FACFE" />
                  <Setter Property="Foreground" Value="#00F2FE" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="#4FACFE" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TitleText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground">
          <Setter.Value>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#00F2FE" Offset="0" />
              <GradientStop Color="#4FACFE" Offset="1" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="HYPERCACHE X" Style="{StaticResource TitleText}">
          <TextBlock.Effect>
            <DropShadowEffect BlurRadius="10" Color="#00F2FE" Opacity="0.45" ShadowDepth="0" />
          </TextBlock.Effect>
        </TextBlock>
        <Border Background="#4FACFE" Padding="8,3" CornerRadius="4" VerticalAlignment="Bottom" Margin="12,0,0,6">
          <TextBlock Text="3-TIER HYBRID + RAMDISK v2.2" Foreground="#FF000000" FontSize="10" FontWeight="Bold" />
        </Border>
      </StackPanel>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
        <TextBlock Text="エンジンの状態:" Foreground="#888" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#FF4444" Margin="0,0,6,0" />
        <TextBlock x:Name="TxtStatusLabel" Text="停止中" FontWeight="Bold" Foreground="#FF4444" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- KPI Cards -->
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
      <Border Style="{StaticResource CardPanel}" Margin="0,0,6,0">
        <StackPanel>
          <TextBlock Text="キャッシュヒット率" Foreground="#888" FontSize="11" HorizontalAlignment="Center" />
          <TextBlock x:Name="HitRateText" Text="0.0%" Foreground="#00F2FE" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,2" />
          <TextBlock x:Name="HitDetailText" Text="L1: 0.0% / L2: 0.0%" Foreground="#778" FontSize="10" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardPanel}" Margin="6,0">
        <StackPanel>
          <TextBlock Text="キャッシュ使用量" Foreground="#888" FontSize="11" HorizontalAlignment="Center" />
          <TextBlock x:Name="CachedBlocksText" Text="0 MB" Foreground="#4FACFE" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,2" />
          <TextBlock x:Name="CachedDetailText" Text="L1: 0 / L2: 0 blk" Foreground="#778" FontSize="10" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardPanel}" Margin="6,0">
        <StackPanel>
          <TextBlock Text="AI スコア (Avg)" Foreground="#888" FontSize="11" HorizontalAlignment="Center" />
          <TextBlock x:Name="AiScoreText" Text="0.00" Foreground="#F6D365" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,2" />
          <TextBlock x:Name="DirtyBlocksText" Text="Dirty: 0 blk" Foreground="#778" FontSize="10" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardPanel}" Margin="6,0,0,0">
        <StackPanel>
          <TextBlock Text="スマートフィルタ" Foreground="#888" FontSize="11" HorizontalAlignment="Center" />
          <TextBlock x:Name="FilterStatusText" Text="ACTIVE" Foreground="#43E97B" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,2">
            <TextBlock.Effect>
              <DropShadowEffect Color="#43E97B" BlurRadius="8" ShadowDepth="0" />
            </TextBlock.Effect>
          </TextBlock>
          <TextBlock x:Name="SeqBypassText" Text="Seq除外: 0" Foreground="#778" FontSize="10" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Main Body -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="380" />
      </Grid.ColumnDefinitions>

      <!-- Left: Heatmap + Active Mappings + Audit Log -->
      <Grid Grid.Column="0" Margin="0,0,12,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="1.7*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="1.2*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,12">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="ブロックアクセス・ヒートマップ (32×8 / 256バケット)" FontSize="12" Foreground="#888" FontWeight="Bold" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#00F2FE" Margin="0,0,4,0" />
                <TextBlock Text="L1 RAM/RAMDisk" FontSize="10" Foreground="#AAA" Margin="0,0,10,0" />
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#4FACFE" Margin="0,0,4,0" />
                <TextBlock Text="L2 SSD" FontSize="10" Foreground="#AAA" Margin="0,0,10,0" />
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#FFB300" Margin="0,0,4,0" />
                <TextBlock Text="Dirty" FontSize="10" Foreground="#AAA" />
              </StackPanel>
            </Grid>
            <Border Background="#0D0D0F" CornerRadius="8" Padding="10">
              <UniformGrid x:Name="HeatmapGrid" Columns="32" Rows="8" />
            </Border>
          </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,12" Padding="12,10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="稼働状態:" FontSize="11" Foreground="#888" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock x:Name="TxtActiveMappings" Text="なし（設定を選択して「エンジンの起動」を押してください）" FontSize="11" Foreground="#4FACFE" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardPanel}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="システム監査ログ" FontSize="12" Foreground="#888" Margin="0,0,0,8" FontWeight="Bold" />
            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
              <TextBox x:Name="LogOutput" Background="#00FFFFFF" Foreground="#8BC34A" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Opacity="0.9" />
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Right: Performance Monitor + 2-Tab Configuration -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="パフォーマンスモニター" FontSize="12" Foreground="#888" Margin="0,0,0,8" FontWeight="Bold" />
              <Grid>
                <StackPanel>
                  <TextBlock Text="リアルタイム I/O スループット" FontSize="11" Foreground="#4FACFE" />
                  <TextBlock x:Name="TxtThroughput" Text="0.0 MB/s" FontSize="28" FontWeight="Light" Foreground="#FFFFFFFF" />
                </StackPanel>
                <Path Data="M0,20 Q10,15 20,25 Q30,35 40,15" Stroke="#4FACFE" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Width="60" Height="30" Stretch="Fill" Opacity="0.55" />
              </Grid>
              <Rectangle Height="1" Fill="#25252D" Margin="0,8" />
              <TextBlock Text="エンジン統計" FontSize="11" Foreground="#8BC34A" Margin="0,0,0,2" />
              <TextBlock x:Name="TxtStats" Text="待機中..." FontSize="12" Foreground="#E0E0E0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardPanel}">
            <StackPanel>
              <TabControl>
                <TabItem Header="ハイブリッド加速">
                  <StackPanel>
                    <TextBlock Text="加速ターゲット (HDD / フォルダ)" FontSize="10" Margin="0,0,0,4" Foreground="#AAA" />
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ComboBox x:Name="DiskList" Grid.Column="0" Height="28" Margin="0,0,6,0" SelectionChanged="DiskList_SelectionChanged">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button x:Name="BtnBrowseTarget" Grid.Column="1" Content="フォルダ..." Height="28" FontSize="10" Padding="8,4" Click="BtnBrowseTarget_Click" />
                    </Grid>
                    <TextBlock x:Name="TxtTargetPath" Text="" FontSize="10" Foreground="#4FACFE" Margin="0,-4,0,8" TextTrimming="CharacterEllipsis" />

                    <TextBlock x:Name="TxtHostRamLabel" Text="L1 キャッシュ (既存RAMDisk優先)" FontSize="10" Margin="0,0,0,4" Foreground="#AAA" />
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="0.8*" />
                      </Grid.ColumnDefinitions>
                      <ComboBox x:Name="L1BackendCombo" Grid.Column="0" Height="28" Margin="0,0,5,0" SelectedIndex="0" SelectionChanged="L1BackendCombo_SelectionChanged">
                        <ComboBoxItem Content="自動 (既存RAMDisk優先→RAM)" Tag="AutoPreferRamDisk" />
                        <ComboBoxItem Content="RAMDisk ファイルのみ" Tag="RamDiskFile" />
                        <ComboBoxItem Content="プロセス内 RAM のみ" Tag="InProcessRam" />
                        <ComboBoxItem Content="OFF (L1 なし)" Tag="Disabled" />
                      </ComboBox>
                      <ComboBox x:Name="RamSizeCombo" Grid.Column="1" Height="28" Margin="5,0,0,0" SelectedIndex="2">
                        <ComboBoxItem Content="256 MB" Tag="256" />
                        <ComboBoxItem Content="512 MB" Tag="512" />
                        <ComboBoxItem Content="1 GB" Tag="1024" />
                        <ComboBoxItem Content="2 GB" Tag="2048" />
                        <ComboBoxItem Content="4 GB" Tag="4096" />
                        <ComboBoxItem Content="8 GB" Tag="8192" />
                        <ComboBoxItem Content="16 GB" Tag="16384" />
                      </ComboBox>
                    </Grid>

                    <TextBlock Text="L1 優先 RAMDisk ドライブ" FontSize="10" Margin="0,0,0,4" Foreground="#AAA" />
                    <ComboBox x:Name="L1RamDiskCombo" Height="28" Margin="0,0,0,8">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="0.8*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="L2 SSD キャッシュ先" FontSize="10" Margin="0,0,0,4" Foreground="#AAA" />
                        <ComboBox x:Name="SsdList" Height="28">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="L2 SSD 上限" FontSize="10" Margin="0,0,0,4" Foreground="#AAA" />
                        <ComboBox x:Name="SsdSizeCombo" Height="28" SelectedIndex="4">
                          <ComboBoxItem Content="OFF (0 MB)" Tag="0" />
                          <ComboBoxItem Content="256 MB" Tag="256" />
                          <ComboBoxItem Content="512 MB" Tag="512" />
                          <ComboBoxItem Content="1 GB" Tag="1024" />
                          <ComboBoxItem Content="2 GB" Tag="2048" />
                          <ComboBoxItem Content="4 GB" Tag="4096" />
                          <ComboBoxItem Content="8 GB" Tag="8192" />
                          <ComboBoxItem Content="16 GB" Tag="16384" />
                        </ComboBox>
                      </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="書き込みポリシー" FontSize="10" Margin="0,0,0,4" Foreground="#AAA" />
                        <ComboBox x:Name="WritePolicyCombo" Height="28" SelectedIndex="0" SelectionChanged="WritePolicyCombo_SelectionChanged" ToolTip="ライトバックは高速ですが急な電源断に注意（OS終了・アプリ終了時は安全同期します）。ライトスルーは即時HDD書込で最も安全です。">
                          <ComboBoxItem Content="ライトバック (高速)" Tag="WriteBack" />
                          <ComboBoxItem Content="ライトスルー (安全)" Tag="WriteThrough" />
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="仮想ドライブ (WinFsp)" FontSize="10" Margin="0,0,0,4" Foreground="#AAA" />
                        <ComboBox x:Name="MountPointCombo" Height="28" />
                      </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="0.85*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="パフォーマンスモード" FontSize="10" Margin="0,0,0,4" Foreground="#AAA" />
                        <ComboBox x:Name="PerformanceMode" SelectedIndex="1" Height="28">
                          <ComboBoxItem Content="効率優先 (SSD摩耗抑制)" />
                          <ComboBoxItem Content="バランス (標準)" />
                          <ComboBoxItem Content="パフォーマンス (積極昇格)" />
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Write-Back 同期間隔" FontSize="10" Margin="0,0,0,4" Foreground="#AAA" />
                        <ComboBox x:Name="FlushIntervalCombo" SelectedIndex="3" Height="28">
                          <ComboBoxItem Content="1 秒 (最安全)" Tag="1" />
                          <ComboBoxItem Content="3 秒" Tag="3" />
                          <ComboBoxItem Content="5 秒" Tag="5" />
                          <ComboBoxItem Content="10 秒 (標準)" Tag="10" />
                          <ComboBoxItem Content="30 秒" Tag="30" />
                          <ComboBoxItem Content="60 秒 (効率)" Tag="60" />
                        </ComboBox>
                      </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="#25252D" Margin="0,0,0,8" />
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="WinFsp 仮想ドライブ基盤:" FontSize="10" Foreground="#888" VerticalAlignment="Center" />
                      <TextBlock x:Name="TxtWinFspStatus" Text="確認中..." FontSize="10" Foreground="#FFAA00" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <Button x:Name="BtnSetupWinFsp" Content="WinFsp セットアップ / 状態更新" Height="26" Margin="0,0,0,10" FontSize="10" Click="BtnSetupWinFsp_Click" />

                    <Button x:Name="BtnStart" Content="エンジンの起動" Height="38" Margin="0,0,0,8" FontWeight="Bold" Foreground="#FF000000" Click="BtnStart_Click">
                      <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Color="#4FACFE" Offset="0" />
                          <GradientStop Color="#00F2FE" Offset="1" />
                        </LinearGradientBrush>
                      </Button.Background>
                    </Button>

                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Button x:Name="BtnSyncNow" Grid.Column="0" Content="今すぐ同期" Height="30" Margin="0,0,4,0" IsEnabled="False" FontSize="11" Click="BtnSyncNow_Click" />
                      <Button x:Name="BtnBenchmark" Grid.Column="1" Content="実測ベンチマーク" Height="30" Margin="4,0,0,0" FontSize="11" Click="BtnBenchmark_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Button x:Name="BtnStop" Grid.Column="0" Content="加速エンジン停止" Height="30" Margin="0,0,4,0" IsEnabled="False" Foreground="#CCC" Click="BtnStop_Click" />
                      <Button x:Name="BtnClearL2Cache" Grid.Column="1" Content="L2 キャッシュ消去" Height="30" Margin="4,0,0,0" FontSize="11" Foreground="#CCC" Click="BtnClearL2Cache_Click" />
                    </Grid>

                    <StackPanel Orientation="Vertical" Margin="0,2,0,0">
                      <CheckBox x:Name="ChkAutoRestore" Content="前回設定を記憶・起動時に自動復元" Foreground="#AAA" FontSize="10" Margin="0,0,0,4" Click="ChkAutoRestore_Click" />
                      <CheckBox x:Name="ChkAutoStartWindows" Content="Windows 起動時にトレイ常駐 (--minimized)" Foreground="#AAA" FontSize="10" Click="ChkAutoStartWindows_Click" />
                    </StackPanel>
                  </StackPanel>
                </TabItem>

                <TabItem Header="内蔵 RAMディスク">
                  <StackPanel>
                    <Border Background="#121824" BorderBrush="#26405C" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                      <StackPanel>
                        <TextBlock Text="既存 RAMディスク検出状態" FontSize="10" Foreground="#4FACFE" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtExistingRamDiskInfo" Text="確認中..." FontSize="11" Foreground="#DCE8F5" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <TextBlock Text="新規 WinFsp RAMディスク作成 (揮発性)" FontSize="11" FontWeight="Bold" Foreground="#CCC" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="マウント先ドライブ" FontSize="10" Margin="0,0,0,4" Foreground="#AAA" />
                        <ComboBox x:Name="RamDiskMountCombo" Height="28" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="RAMディスク容量" FontSize="10" Margin="0,0,0,4" Foreground="#AAA" />
                        <ComboBox x:Name="RamDiskCapacityCombo" Height="28" SelectedIndex="2">
                          <ComboBoxItem Content="512 MB" Tag="512" />
                          <ComboBoxItem Content="1 GB" Tag="1024" />
                          <ComboBoxItem Content="2 GB" Tag="2048" />
                          <ComboBoxItem Content="4 GB" Tag="4096" />
                          <ComboBoxItem Content="8 GB" Tag="8192" />
                          <ComboBoxItem Content="16 GB" Tag="16384" />
                        </ComboBox>
                      </StackPanel>
                    </Grid>

                    <TextBlock Text="ボリュームラベル" FontSize="10" Margin="0,0,0,4" Foreground="#AAA" />
                    <TextBox x:Name="TxtRamDiskLabel" Text="HCX_RAMDISK" Height="28" Padding="6,4" Background="#121218" Foreground="#E0E0E0" BorderBrush="#2A2A35" Margin="0,0,0,12" />

                    <Button x:Name="BtnCreateRamDisk" Content="RAMディスクを作成・マウント" Height="38" Margin="0,0,0,8" FontWeight="Bold" Foreground="#FF000000" Click="BtnCreateRamDisk_Click">
                      <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Color="#43E97B" Offset="0" />
                          <GradientStop Color="#38F9D7" Offset="1" />
                        </LinearGradientBrush>
                      </Button.Background>
                    </Button>

                    <Button x:Name="BtnUnmountAllRamDisks" Content="作成した RAMディスクをすべて解除" Height="30" IsEnabled="False" Margin="0,0,0,12" Click="BtnUnmountAllRamDisks_Click" />

                    <Border Background="#111117" BorderBrush="#25252D" BorderThickness="1" CornerRadius="6" Padding="10">
                      <StackPanel>
                        <TextBlock Text="稼働中の HCX RAMディスク" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,4" />
